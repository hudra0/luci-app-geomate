#!/usr/bin/env lua

local jsonc = require "luci.jsonc"
local uci = require "luci.model.uci".cursor()
local nixio = require "nixio"

local cache_file = "/tmp/geomate_ip_cache.json"
local cache = {}

-- Load the cache from file
local function load_cache()
    local f = io.open(cache_file, "r")
    if f then
        local content = f:read("*a")
        cache = jsonc.parse(content) or {}
        f:close()
    end
end

-- Save the cache to file
local function save_cache()
    local f = io.open(cache_file, "w")
    if f then
        f:write(jsonc.stringify(cache))
        f:close()
    end
end

-- Text fields of an ip-api result that the connections table and the map popups show.
-- Additive: cache entries written before they existed carry lat/lon only and stay valid
local GEO_TEXT_FIELDS = { "country", "countryCode", "city", "isp", "org" }

-- Geo data of the filters: <filter name>_geo_data.json, JSON lines from ip-api
local GEO_DATA_DIR = "/etc/geomate.d"

-- Filter names the backend supports in nft set names and geo data file names. A name that
-- matches contains no '/' and no shell quote
local FILTER_NAME_PATTERN = "^[%w_ .%-]+$"

-- Cache entry of one geo data line for an IP, or nil if the line has no position
local function geo_entry(line, ip)
    local data = jsonc.parse(line)
    if not (data and data.query == ip and data.lat and data.lon) then
        return nil
    end

    local entry = { lat = data.lat, lon = data.lon }
    for _, k in ipairs(GEO_TEXT_FIELDS) do
        if type(data[k]) == "string" and data[k] ~= "" then
            entry[k] = data[k]
        end
    end
    return entry
end

-- One pass over the geo data file of a filter for the IPs in 'wanted' ({ [ip] = true }).
-- A hit is cached and leaves 'wanted'. Only a line whose "query" is wanted gets a JSON parse;
-- geolocate.sh writes the compact "query":"<ip>" form, at the end of the line. Plain finds
-- only, an unanchored pattern would be tried at every position of the line: for one IP its
-- whole key, else the key name and the address right behind it
local function scan_geo_file(name, wanted)
    -- A matching name contains no '/', so the path stays in the directory
    local f = next(wanted) and type(name) == "string" and name:match(FILTER_NAME_PATTERN)
        and io.open(GEO_DATA_DIR .. "/" .. name .. "_geo_data.json", "r")
    if not f then
        return
    end

    local only = next(wanted, next(wanted)) == nil and next(wanted)
    local needle = only and ('"query":"' .. only .. '"')
    for line in f:lines() do
        local ip
        if needle then
            ip = line:find(needle, 1, true) and only
        else
            local p = line:find('"query":"', 1, true)
            ip = p and line:match('^([%d%.]+)"', p + 9)
        end
        local entry = ip and wanted[ip] and geo_entry(line, ip)
        if entry then
            cache[ip] = entry
            wanted[ip] = nil
            if not next(wanted) then
                break
            end
        end
    end
    f:close()
end

-- Looks up the IPs without a cache entry, all of one request together: wanted is
-- { [filter name] = { [ip] = true } }. First each filter's own geo data file for its IPs, then
-- the files of the other enabled filters for what is still missing, until all are found; an
-- untracked server is a miss in almost every file, so files of disabled or removed filters are
-- not read. Each file is read at most twice per request. Misses are cached too, until the
-- next service start or frequent geolocation batch deletes the cache file.
-- The caller loads the geomate config. Returns true if the cache changed
local function lookup_geo(wanted)
    local missing, own_file = {}, {}

    for name, ips in pairs(wanted) do
        local todo = {}
        for ip in pairs(ips) do
            if not cache[ip] and not own_file[ip] then
                todo[ip] = true
                own_file[ip] = name
            end
        end
        scan_geo_file(name, todo)
        for ip in pairs(todo) do
            missing[ip] = true
        end
    end

    if next(missing) then
        local scanned = {}
        uci:foreach('geomate', 'geo_filter', function(s)
            local name = s.name
            if s.enabled ~= '1' or type(name) ~= "string" or scanned[name] or not next(missing) then
                return
            end
            scanned[name] = true

            -- The own file of an IP was read above
            local todo = {}
            for ip in pairs(missing) do
                if own_file[ip] ~= name then
                    todo[ip] = true
                end
            end
            scan_geo_file(name, todo)
            for ip in pairs(missing) do
                if cache[ip] then
                    missing[ip] = nil
                end
            end
        end)
    end

    for ip in pairs(missing) do
        cache[ip] = {}
    end
    return next(own_file) ~= nil
end

-- A number with a leading zero ('012', '024'), which nft reads as octal: an entry with one is
-- not the address or prefix it seems to be, so it counts as nothing
local function has_leading_zero(s)
    return s:find("^0%d") or s:find("%.0%d")
end

-- An IPv4 address as a number, nil for anything else (also for an octet with a leading zero)
local function ip_number(ip)
    local a, b, c, d = ip:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
    a, b, c, d = tonumber(a), tonumber(b), tonumber(c), tonumber(d)
    if not a or a > 255 or b > 255 or c > 255 or d > 255 or has_leading_zero(ip) then
        return nil
    end
    return ((a * 256 + b) * 256 + c) * 256 + d
end

-- Address sets as nft holds them: { ips = { [address] = true }, ranges = { { lo, hi }, … } }
local function new_set()
    return { ips = {}, ranges = {} }
end

-- Adds a set element or an allowed_ip entry: an address, a prefix (a.b.c.d/nn) or a range
-- (a.b.c.d-e.f.g.h). An address goes in as written, without a parse: set_has() looks up the
-- dotted form nft prints, which an entry with a leading zero, a '!' or a typo never equals.
-- A prefix or range that does not parse is skipped
local function add_element(set, element)
    if not element:find("[/%-]") then
        set.ips[element] = true
        return
    end

    local addr, bits = element:match("^([%d%.]+)/(%d+)$")
    if addr then
        local n = ip_number(addr)
        if n and not has_leading_zero(bits) and tonumber(bits) <= 32 then
            local size = 2 ^ (32 - tonumber(bits))
            local lo = n - n % size
            table.insert(set.ranges, { lo, lo + size - 1 })
        end
        return
    end

    local from, to = element:match("^([%d%.]+)%-([%d%.]+)$")
    if from then
        local lo, hi = ip_number(from), ip_number(to)
        if lo and hi and lo <= hi then
            table.insert(set.ranges, { lo, hi })
        end
    end
end

-- Whether a set contains an address (dotted, as nft prints it): the hash first, then the few
-- prefixes and ranges
local function set_has(set, ip)
    if set.ips[ip] then
        return true
    end
    local n = next(set.ranges) and ip_number(ip)
    if not n then
        return false
    end
    for _, r in ipairs(set.ranges) do
        if n >= r[1] and n <= r[2] then
            return true
        end
    end
    return false
end

-- Public IPv4 addresses as geomate.sh's is_valid_public_ip sees them (CGNAT 100.64/10 counts
-- as public), without the router's own addresses (own: { [ip] = true })
local function is_public_ip(ip, own)
    local a, b = ip:match("^(%d+)%.(%d+)%.")
    a, b = tonumber(a), tonumber(b)
    if not a or own[ip] then
        return false
    end
    return not (a == 0 or a == 10 or a == 127 or a >= 224
        or (a == 169 and b == 254)
        or (a == 172 and b >= 16 and b <= 31)
        or (a == 192 and b == 168))
end

-- IPv4 addresses of the router's interfaces, read without a fork. A filter without Source IP
-- also sees traffic to the router itself, e.g. to its WAN address
local function router_addresses()
    local own = {}
    for _, ifa in ipairs(nixio.getifaddrs() or {}) do
        if ifa.family == "inet" and ifa.addr then
            own[ifa.addr] = true
        end
    end
    return own
end

-- Helper function to parse port lists and ranges
local function parse_ports(port_str)
    local ports = {}
    for part in string.gmatch(port_str, '([^,]+)') do
        if string.find(part, '-') then
            local start_port, end_port = string.match(part, '(%d+)%-(%d+)')
            if start_port and end_port then
                for p = tonumber(start_port), tonumber(end_port) do
                    ports[p] = true
                end
            else
                local port = tonumber(part)
                if port then
                    ports[port] = true
                end
            end
        else
            local port = tonumber(part)
            if port then
                ports[port] = true
            end
        end
    end
    return ports
end

-- Check if a port is within the port list or range
local function port_matches(port, port_set)
    if port_set["any"] then
        return true
    end
    return port_set[tonumber(port)] or false
end

-- nft set name prefix of a filter, or nil if the name must not reach a shell command.
-- The pattern covers what the backend supports in nft set names and file names
local function filter_set_name(name)
    if type(name) ~= "string" or not name:match(FILTER_NAME_PATTERN) then
        return nil
    end
    return "geomate_" .. (name:gsub(' ', '_'))
end

-- Output of 'nft list set inet geomate <set>', '' if there is none. Only names built by
-- filter_set_name() reach the shell
local function nft_list_set(set_name)
    local handle = io.popen("nft list set inet geomate '" .. set_name .. "' 2>/dev/null")
    if not handle then
        return ""
    end
    local result = handle:read("*a") or ""
    handle:close()
    return result
end

-- A cache entry for one row of an answer, with or without lat/lon. Rows never share a table:
-- luci.jsonc writes a table that appears twice in one answer as null, and an IP can be an
-- allowed IP of several filters
local function geo_copy(geo, with_position)
    local copy = with_position and { lat = geo.lat, lon = geo.lon } or {}
    for _, k in ipairs(GEO_TEXT_FIELDS) do
        copy[k] = geo[k]
    end
    return copy
end

-- The 'elements = { ... }' block of a set, '' for an empty or missing one. Only the block: the
-- header holds the set name, and a filter named e.g. 'Game 1.2.3.4' must not add an element
local function set_elements(set_name)
    return nft_list_set(set_name):match("elements = {(.-)}") or ""
end

-- Packets and bytes of an address in the 'nft list set' output of a set with the counter flag,
-- where each element reads '<ip> counter packets N bytes M'; nil when the address has none.
-- Plain finds from the elements block on, only for the IPs a reply shows: a pattern pass over
-- 2000 elements takes about 7 ms on an Intel N100
local function element_counter(listing, ip)
    local needle = ip .. " counter packets "
    local from = listing:find("elements = {", 1, true)

    while from do
        local p = listing:find(needle, from, true)
        if not p then
            return nil
        end
        -- '45.6.7.8' contains '5.6.7.8': an element starts after a blank or the '{'
        if listing:find("^[%s{]", p - 1) then
            local packets, bytes = listing:match("^(%d+) bytes (%d+)", p + #needle)
            return tonumber(packets), tonumber(bytes)
        end
        from = p + 1
    end
    return nil
end

-- Elements of an _allowed or _blocked set (flags interval): addresses, prefixes and ranges
local function read_set(set_name)
    local set = new_set()
    for element in set_elements(set_name):gmatch("[^%s,]+") do
        add_element(set, element)
    end
    return set
end

-- allowed_ip of a filter section, split like the backend splits it: list entries only
-- (config_list_foreach), so a hand-written 'option allowed_ip', which arrives as a string,
-- whitelists nothing; an entry can hold several addresses, prefixes or ranges, separated by
-- whitespace or commas (the Allowed IPs field accepts '1.2.3.4 5.6.7.8' as one entry)
local function allowed_ip_list(s)
    local tokens = {}
    if type(s.allowed_ip) == "table" then
        for _, entry in ipairs(s.allowed_ip) do
            for token in tostring(entry):gmatch("[^%s,]+") do
                table.insert(tokens, token)
            end
        end
    end
    return tokens
end

-- Blocked IPs of a filter section as the backend merges them (filter_set_entries): the entries
-- of list blocked_ip, where a hand-written 'option blocked_ip' blocks nothing as with
-- allowed_ip, and the older comma-separated option blocked_ips (read with config_get, so also
-- a hand-written list), split at whitespace and commas
local function blocked_ip_list(s)
    local tokens = {}
    local legacy = s.blocked_ips
    for _, entries in ipairs({ type(s.blocked_ip) == "table" and s.blocked_ip or {},
            type(legacy) == "table" and legacy or { legacy } }) do
        for _, entry in ipairs(entries) do
            for token in tostring(entry):gmatch("[^%s,]+") do
                table.insert(tokens, token)
            end
        end
    end
    return tokens
end

-- Feature tokens of the installed backend: '/etc/geomate.sh capabilities' prints one line of
-- space-separated tokens (fixed command, no input). An older geomate.sh prints its usage and
-- exits 1; any line that is not lowercase tokens counts as no capabilities. Tokens are only
-- added, never renamed. src_ip_multi: Source IP takes several entries and exceptions;
-- blocked_ip: blocked IPs win over the regions
local function backend_capabilities()
    local caps = {}
    local handle = io.popen("/etc/geomate.sh capabilities 2>/dev/null")
    if handle then
        local line = handle:read("*l")
        handle:close()
        if line and line:match("^[%l%d_ ]*$") then
            for token in line:gmatch("[%l%d_]+") do
                table.insert(caps, token)
            end
        end
    end
    return caps
end

-- Servers the enabled filters see right now (_ui_dynamic), one entry per IP:
-- { ip, filter = <section>, allowed = true (in _allowed), false (in _blocked) or nil }.
-- nil means untracked: not geolocated yet, or the filter has no circles. _allowed wins because
-- the accept rule comes before the drop rule. If several filters see an IP, their rules run in
-- config order: the first filter with a verdict wins. With strict_mode the first filter that
-- sees the IP decides, because its catch-all drop stops an untracked server before any later
-- filter. strict_mode counts in monitor mode too: the table shows what the rules would do.
-- Private and reserved addresses and the router's own addresses are left out.
-- with_counters: also the 'nft list set' output of the _dynamic set of each filter that sees a
-- server, as { [section] = text }. Read after the other sets, never through a pipe left open
-- meanwhile: within uci:foreach the next popen read then came back empty, and an allowed
-- server showed as blocked
local function get_ui_dynamic_ips(with_counters)
    local entries, by_ip, listings = {}, {}, {}
    local own = router_addresses()

    uci:load('geomate')
    local strict = uci:get('geomate', 'global', 'strict_mode') == '1'
    -- Static mode has no _dynamic set
    with_counters = with_counters and uci:get('geomate', 'global', 'operational_mode') ~= 'static'
    uci:foreach('geomate', 'geo_filter', function(s)
        local set_name = filter_set_name(s.name)
        if s.enabled ~= '1' or not set_name then
            return
        end

        -- IPs this filter may still claim: new ones, and without strict_mode untracked ones of
        -- an earlier filter
        local candidates = {}
        for ip in set_elements(set_name .. "_ui_dynamic"):gmatch("(%d+%.%d+%.%d+%.%d+)") do
            local entry = by_ip[ip]
            if (not entry or (entry.allowed == nil and not strict)) and is_public_ip(ip, own) then
                table.insert(candidates, ip)
            end
        end
        if #candidates == 0 then
            return
        end

        local allowed = read_set(set_name .. "_allowed")
        local blocked = read_set(set_name .. "_blocked")
        if with_counters then
            listings[s['.name']] = nft_list_set(set_name .. "_dynamic")
        end
        for _, ip in ipairs(candidates) do
            local verdict = nil
            if set_has(allowed, ip) then
                verdict = true
            elseif set_has(blocked, ip) then
                verdict = false
            end

            local entry = by_ip[ip]
            if not entry then
                entry = { ip = ip, filter = s, allowed = verdict }
                by_ip[ip] = entry
                table.insert(entries, entry)
            elseif verdict ~= nil then
                entry.filter, entry.allowed = s, verdict
            end
        end
    end)

    return entries, listings
end

-- Connections from the _ui_dynamic sets of the enabled filters (previously also from conntrack)
-- with the verdict of the filter's nft sets. is_allowed_ip: the IP is in _allowed and in the
-- filter's own allowed_ip, as an address or inside a prefix or range. The set has to agree:
-- nft rejects the whole allowed_ip batch for one '!' entry, and a saved change counts only
-- after the next service start.
-- is_blocked_ip, only when true: the IP is in _blocked, not in _allowed, and in the filter's
-- own blocked IPs (blocked_ip_list), and the backend reports blocked_ip. An older backend puts
-- a blocked IP inside a region in _allowed and ignores list blocked_ip: none of its servers
-- is blacklisted. The backend is asked only for a row that needs it.
-- with_counters (the page asks for them when the backend reports set_counters): packets and
-- bytes the kernel counted for the server in the filter's _dynamic set, since its first packet
-- after the last service start or after an hour without one. Left out when the set has none,
-- as in static mode, which has no _dynamic set
local function get_all_connections(with_counters)
    load_cache()
    local entries, listings = get_ui_dynamic_ips(with_counters)

    local wanted = {}
    for _, e in ipairs(entries) do
        local name = e.filter.name
        wanted[name] = wanted[name] or {}
        wanted[name][e.ip] = true
    end
    local changed = lookup_geo(wanted)

    local connections, whitelists, blocklists, blocks_ips = {}, {}, {}, nil
    for _, e in ipairs(entries) do
        local s = e.filter
        local whitelisted, blacklisted = false, false
        if e.allowed == true then
            local whitelist = whitelists[s['.name']]
            if not whitelist then
                whitelist = new_set()
                for _, entry in ipairs(allowed_ip_list(s)) do
                    add_element(whitelist, entry)
                end
                whitelists[s['.name']] = whitelist
            end
            whitelisted = set_has(whitelist, e.ip)
        elseif e.allowed == false then
            local blocklist = blocklists[s['.name']]
            if not blocklist then
                blocklist = new_set()
                for _, entry in ipairs(blocked_ip_list(s)) do
                    add_element(blocklist, entry)
                end
                blocklists[s['.name']] = blocklist
            end
            if set_has(blocklist, e.ip) then
                if blocks_ips == nil then
                    blocks_ips = table_contains(backend_capabilities(), "blocked_ip")
                end
                blacklisted = blocks_ips
            end
        end

        -- No position for an untracked server: older map.html versions draw a connection
        -- without 'allowed' as a blocked marker
        local geo = geo_copy(cache[e.ip] or {}, e.allowed ~= nil)
        local listing = listings[s['.name']]
        local packets, bytes
        if listing then
            packets, bytes = element_counter(listing, e.ip)
        end

        local row = {
            src = "unknown",
            dst = e.ip,
            protocol = "unknown",
            sport = "unknown",
            dport = "unknown",
            allowed = e.allowed,
            geo = geo,
            filter_name = s.name,
            is_dynamic = true,        -- Indicates the connection is from a dynamic set
            is_allowed_ip = whitelisted,
            packets = packets,
            bytes = bytes
        }
        -- Added afterwards: a row without it is the same table as before, so a reply without
        -- blacklisted servers stays byte for byte the same
        if blacklisted then
            row.is_blocked_ip = true
        end
        table.insert(connections, row)
    end

    if changed then
        save_cache()
    end
    return connections
end

-- Retrieve allowlist IPs with their geo data; entries without a position are left out
local function get_allowed_ips()
    local filters, wanted = {}, {}

    uci:load('geomate')
    uci:foreach('geomate', 'geo_filter', function(s)
        -- A hand-written 'list name' arrives as a table and names no filter
        if s.enabled == '1' and type(s.name or "") == "string" then
            local name, ips = s.name or "", {}
            for _, ip in ipairs(allowed_ip_list(s)) do
                if ip_number(ip) then
                    table.insert(ips, ip)
                    wanted[name] = wanted[name] or {}
                    wanted[name][ip] = true
                end
            end
            table.insert(filters, { name = s.name, ips = ips })
        end
    end)
    local changed = lookup_geo(wanted)

    local allowed_ips = {}
    for _, f in ipairs(filters) do
        for _, ip in ipairs(f.ips) do
            local geo = cache[ip] or {}
            if geo.lat and geo.lon then
                table.insert(allowed_ips, { ip = ip, geo = geo_copy(geo, true), filter = f.name })
            end
        end
    end

    return allowed_ips, changed
end

-- Known servers of a filter for the map (getKnownServers): the positions in its geo data file,
-- counted per position. Cached per filter name under /tmp, never on flash, while the file keeps
-- its inode, size and mtime (geolocate.sh replaces the file with mv)
local KNOWN_SERVERS_CACHE = "/tmp/geomate_known_servers.json"

-- Above this many positions they are merged to 2 decimals (about 1 km), then to 1 and 0 decimals
-- while there are still more, and the answer says approx and the decimals of the last merge. 0
-- decimals leaves at most 181 * 361
local KNOWN_SERVERS_MAX_POINTS = 3000

-- A position as one key: tostring() of the two numbers. -0 + 0 is 0, so 0 and -0 share a key
local function position_key(lat, lon)
    return tostring(lat + 0) .. "," .. tostring(lon + 0)
end

-- The points merged by their position rounded to the given number of decimals; counts add up
local function merge_positions(points, decimals)
    local fmt, merged, by_key = "%." .. decimals .. "f", {}, {}
    for _, p in ipairs(points) do
        local lat = tonumber(string.format(fmt, p[1])) + 0
        local lon = tonumber(string.format(fmt, p[2])) + 0
        local key = position_key(lat, lon)
        local point = by_key[key]
        if point then
            point[3] = point[3] + p[3]
        else
            point = { lat, lon, p[3] }
            by_key[key] = point
            table.insert(merged, point)
        end
    end
    return merged
end

-- One pass over a geo data file: { total, approx, decimals, points = { { lat, lon, n }, … } }
-- (decimals only when approx), nil if it cannot be read. The exact lat/lon text is the key; a
-- line without a valid position counts nowhere. Both fields come from separate matches, without
-- a JSON parse per line
local function count_positions(path)
    local f = io.open(path, "r")
    if not f then
        return nil
    end

    local points, by_text, total = {}, {}, 0
    for line in f:lines() do
        local lat_text = line:match('"lat":(%-?[%d%.]+)')
        local lon_text = lat_text and line:match('"lon":(%-?[%d%.]+)')
        local lat, lon = tonumber(lat_text), tonumber(lon_text)
        if lat and lon and math.abs(lat) <= 90 and math.abs(lon) <= 180 then
            local key = lat_text .. "," .. lon_text
            local point = by_text[key]
            if point then
                point[3] = point[3] + 1
            else
                point = { lat, lon, 1 }
                by_text[key] = point
                table.insert(points, point)
            end
            total = total + 1
        end
    end
    f:close()

    local approx, used = false
    for decimals = 2, 0, -1 do
        if #points <= KNOWN_SERVERS_MAX_POINTS then
            break
        end
        points = merge_positions(points, decimals)
        approx, used = true, decimals
    end
    return { total = total, approx = approx, decimals = used, points = points }
end

-- The known servers cache: { [filter name] = { ino, size, mtime, total, approx, decimals,
-- points } }. An entry written before decimals existed has none, and neither has its answer
local function load_known_servers()
    local f = io.open(KNOWN_SERVERS_CACHE, "r")
    if not f then
        return {}
    end
    local data = jsonc.parse(f:read("*a") or "")
    f:close()
    return type(data) == "table" and data or {}
end

-- Writes the cache through a temp file and a rename, so a parallel call never reads half a file
local function save_known_servers(data)
    local tmp = KNOWN_SERVERS_CACHE .. "." .. nixio.getpid()
    local f = io.open(tmp, "w")
    if not f then
        return
    end
    local ok = f:write(jsonc.stringify(data))
    f:close()
    if not (ok and os.rename(tmp, KNOWN_SERVERS_CACHE)) then
        os.remove(tmp)
    end
end

-- getKnownServers: { total, approx, decimals, points = { { lat, lon, n }, … } } for the
-- geo_filter section sid. Without a geo data file { points = {}, total = 0, missing = true };
-- { error } for an unknown section or a name the backend does not support. Read only, apart
-- from the cache
local function get_known_servers(sid)
    if type(sid) ~= "string" or not sid:match("^[%w_]+$") then
        return { error = "Invalid filter id" }
    end
    uci:load('geomate')
    local s = uci:get_all('geomate', sid)
    if type(s) ~= "table" or s['.type'] ~= 'geo_filter' then
        return { error = "No such filter" }
    end
    local name = s.name
    if type(name) ~= "string" or not name:match(FILTER_NAME_PATTERN) then
        return { error = "Unsupported filter name" }
    end

    -- A matching name contains no '/', so the path stays in the directory
    local path = GEO_DATA_DIR .. "/" .. name .. "_geo_data.json"
    local st = nixio.fs.stat(path)
    if not st or st.type ~= "reg" then
        return { points = {}, total = 0, missing = true }
    end

    local known = load_known_servers()
    local entry = known[name]
    if type(entry) == "table" and entry.ino == st.ino and entry.size == st.size
        and entry.mtime == st.mtime and type(entry.points) == "table" then
        return { total = entry.total, approx = entry.approx, decimals = entry.decimals,
            points = entry.points }
    end

    local result = count_positions(path)
    if not result then
        return { error = "Cannot read the geo data" }
    end

    -- Only entries of configured filters stay in the cache
    local keep = {}
    uci:foreach('geomate', 'geo_filter', function(f)
        if type(f.name) == "string" and type(known[f.name]) == "table" then
            keep[f.name] = known[f.name]
        end
    end)
    keep[name] = { ino = st.ino, size = st.size, mtime = st.mtime,
        total = result.total, approx = result.approx, decimals = result.decimals,
        points = result.points }
    save_known_servers(keep)
    return result
end

-- Server details window (getServerSample): one stamp file per server address with the time of
-- its last sample in ms, in RAM. A sample of a server comes at most every SAMPLE_MIN_GAP ms, and
-- at most SAMPLE_MAX_SERVERS servers get one within SAMPLE_WINDOW ms, across all pages and tabs
local SAMPLE_DIR = "/tmp/geomate/samples"
local SAMPLE_MIN_GAP = 800
local SAMPLE_WINDOW = 3000
local SAMPLE_MAX_SERVERS = 4
-- Stamps of other servers older than this are deleted
local SAMPLE_STALE = 60000

local function now_ms()
    local sec, usec = nixio.gettimeofday()
    return sec * 1000 + math.floor(usec / 1000)
end

-- Whether a server may get a sample now: false plus 'busy' within SAMPLE_MIN_GAP of its last
-- one, false plus 'limit' while SAMPLE_MAX_SERVERS other servers had one within SAMPLE_WINDOW.
-- Read only, apart from deleting stale stamps. A stamp from the future (the clock was set back)
-- counts as stale
local function sample_allowed(ip, now)
    local others = 0
    for name in nixio.fs.dir(SAMPLE_DIR) or function() end do
        local path = SAMPLE_DIR .. "/" .. name
        local f = ip_number(name) and io.open(path, "r")
        local last = f and tonumber(f:read("*l") or "")
        if f then
            f:close()
        end
        local age = last and now - last
        if name == ip then
            if age and age >= 0 and age < SAMPLE_MIN_GAP then
                return false, "busy"
            end
        elseif age and age >= 0 and age < SAMPLE_WINDOW then
            others = others + 1
        elseif f and (not age or age < 0 or age > SAMPLE_STALE) then
            os.remove(path)
        end
    end
    if others >= SAMPLE_MAX_SERVERS then
        return false, "limit"
    end
    return true
end

-- Notes the sample time of a server, through a temp file and a rename
local function stamp_sample(ip, now)
    local tmp = SAMPLE_DIR .. "/." .. ip .. "." .. nixio.getpid()
    local f = io.open(tmp, "w")
    if not f then
        return false
    end
    local ok = f:write(tostring(now), "\n")
    local closed = f:close()
    if not (ok and closed and os.rename(tmp, SAMPLE_DIR .. "/" .. ip)) then
        os.remove(tmp)
        return false
    end
    return true
end

-- Check and reserve under one non-blocking lock: concurrent rpcd processes must share the
-- budget. Closing the descriptor releases the lock even if the process exits. Keep the lock
-- file in place so every caller locks the same inode; no lock is held during nft or ping.
-- Returns ok, the reason when not ok, and the time of the stamp for release_sample()
local function reserve_sample(ip)
    require("nixio.fs").mkdirr(SAMPLE_DIR)
    local lock = nixio.open(SAMPLE_DIR .. "/.lock", "w", "600")
    if not lock then
        return false, "busy"
    end
    if not lock:lock("tlock") then
        lock:close()
        return false, "busy"
    end
    local now = now_ms()
    local ok, reason = sample_allowed(ip, now)
    if ok and not stamp_sample(ip, now) then
        ok, reason = false, "busy"
    end
    lock:close()
    return ok, reason, now
end

-- Takes back a reservation that brought no sample, so that the server does not count toward
-- the limit. A newer stamp of another caller stays
local function release_sample(ip, stamp)
    local path = SAMPLE_DIR .. "/" .. ip
    local f = io.open(path, "r")
    local last = f and tonumber(f:read("*l") or "")
    if f then
        f:close()
    end
    if last == stamp then
        os.remove(path)
    end
end

-- Whether the 'nft list set' output of a set lists the address as an element of its own, with
-- or without a counter; element_counter() finds only elements with one
local function set_lists(listing, ip)
    local from = listing:find("elements = {", 1, true)
    while from do
        local p = listing:find(ip, from, true)
        if not p then
            return false
        end
        if listing:find("^[%s{]", p - 1) and listing:find("^[%s,}]", p + #ip) then
            return true
        end
        from = p + 1
    end
    return false
end

-- One ICMP echo, as LuCI's Diagnostics page sends it: the round trip in ms, nil without a reply
-- within 1 s. The address is a checked dotted quad. BusyBox prints 'min/avg/max = a/b/c ms',
-- iputils 'min/avg/max/mdev = a/b/c/d ms'
local function ping_rtt(ip)
    local handle = io.popen("ping -c1 -W1 -q '" .. ip .. "' 2>/dev/null")
    if not handle then
        return nil
    end
    local out = handle:read("*a") or ""
    handle:close()
    return tonumber(out:match("min/avg/max%S* = [%d%.]+/([%d%.]+)/"))
end

-- getServerSample: the counters of one server of a filter for the details window, polled once
-- per second while it is open. { t, tx = { packets, bytes }, rx = { packets, bytes }, ping, rtt }:
-- t is the router's time of the counter read in ms, so the delay of the request does not change
-- the rates. tx: what the filter's _dynamic set counted for the server (packets to it, backend
-- token set_counters); rx: what its _rx set counted (packets from it, token rx_counters). Each
-- only when the set has a counter for the server. ping: 'ok' with rtt in ms, 'timeout', or 'off'
-- when not asked for. Errors: { error = 'invalid' } for an address that is no public IPv4
-- address or a filter name the backend does not support, 'unknown' when no live or counter set
-- of the filter has the server, 'busy' or 'limit' (sample_allowed).
-- The server must be one of the filter's, so the page pings no other host. LuCI's Diagnostics
-- page already pings any host, so this keeps the window to its purpose; it is no security
-- boundary. 'nft list set' reads one set, but its cost grows with the set: about 2 ms of CPU
-- for an empty one, 25 ms at 2000 and 185 ms at 20000 elements with counters (Intel N100).
-- 'nft get element' would load the whole ruleset, 85 ms per call with 14700 allowed and
-- blocked IPs. So the reservation comes first, and a 'busy' or 'limit' reply lists no set
local function get_server_sample(args)
    args = type(args) == "table" and args or {}
    local ip, prefix = args.ip, filter_set_name(args.filter)
    if type(ip) ~= "string" or not ip_number(ip) or not prefix or not is_public_ip(ip, router_addresses()) then
        return { error = "invalid" }
    end
    -- Carrier-grade NAT is not public either; keep the older connection-list policy unchanged
    local first, second = ip:match("^(%d+)%.(%d+)%.")
    if tonumber(first) == 100 and tonumber(second) >= 64 and tonumber(second) <= 127 then
        return { error = "invalid" }
    end
    local ok, reason, stamp = reserve_sample(ip)
    if not ok then
        return { error = reason }
    end

    -- Read one after the other, each to its end (see get_ui_dynamic_ips)
    local dynamic = nft_list_set(prefix .. "_dynamic")
    local rx_listing = nft_list_set(prefix .. "_rx")
    local t = now_ms()
    local tx_packets, tx_bytes = element_counter(dynamic, ip)
    local rx_packets, rx_bytes = element_counter(rx_listing, ip)
    if not (tx_packets or rx_packets or set_lists(dynamic, ip)
            or set_lists(nft_list_set(prefix .. "_ui_dynamic"), ip)) then
        release_sample(ip, stamp)
        return { error = "unknown" }
    end

    local reply = { t = t, ping = "off" }
    if tx_packets and tx_bytes then
        reply.tx = { packets = tx_packets, bytes = tx_bytes }
    end
    if rx_packets and rx_bytes then
        reply.rx = { packets = rx_packets, bytes = rx_bytes }
    end
    if args.ping == true then
        reply.rtt = ping_rtt(ip)
        reply.ping = reply.rtt and "ok" or "timeout"
    end
    return reply
end

-- Route RTT is independent of server ping. One globally locked job sends at most 24
-- small ICMP probes, to the selected server only. TTL hints avoid repeated full traces.
local ROUTE_DIR = "/tmp/geomate/route"
local ROUTE_GAP = 2
local ROUTE_REDISCOVER = 60
local ROUTE_HINT_AGE = 180
-- A reply counts within ROUTE_WAIT s of its probe, so hops and servers beyond 200 ms count
-- too. The search sends ROUTE_BATCH TTLs at once; a refresh sends its second probe when the
-- first has no reply after ROUTE_RETRY s. Every TTL of a batch from the server's hop on
-- reaches the server, so a near one gets up to 8 echo requests per search. Echoes can arrive
-- out of order: after the first, the lower TTLs of the batch have ROUTE_GRACE s to answer
local ROUTE_WAIT = 1.2
local ROUTE_BATCH = 8
local ROUTE_RETRY = 0.5
local ROUTE_GRACE = 0.05

local function route_uptime()
    local f = io.open("/proc/uptime", "r")
    if not f then return nil end
    local value = tonumber((f:read(64) or ""):match("^(%d+%.?%d*)"))
    f:close()
    return value
end

local function route_word(n)
    return string.char(math.floor(n / 256) % 256, n % 256)
end

local function route_address(ip)
    local a, b, c, d = ip:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
    return string.char(tonumber(a), tonumber(b), tonumber(c), tonumber(d))
end

local function route_checksum(data)
    local total = 0
    for i = 1, #data, 2 do
        total = total + data:byte(i) * 256 + (data:byte(i + 1) or 0)
    end
    while total > 65535 do total = total % 65536 + math.floor(total / 65536) end
    return 65535 - total
end

-- Nixio exposes IP_HDRINCL, but not IP_TTL. Linux fills the IPv4 length, checksum,
-- zero source address and zero packet ID; the ICMP checksum remains ours.
local function route_packet(ip, id, seq, ttl)
    local echo = string.char(8, 0, 0, 0) .. route_word(id) .. route_word(seq) .. "geomate-route"
    echo = echo:sub(1, 2) .. route_word(route_checksum(echo)) .. echo:sub(5)
    return string.char(69, 0, 0, 0, 0, 0, 0, 0, ttl, 1, 0, 0, 0, 0, 0, 0)
        .. route_address(ip) .. echo
end

-- Only an exact endpoint echo or a correlated TTL-expired message can supply RTT.
-- ICMP unreachable and other control messages are not alternate latency sources.
-- Returns whether the server itself answered, and the sequence number of the probe
local function route_reply(data, host, ip, id)
    if type(host) ~= "string" or not ip_number(host) or type(data) ~= "string"
            or #data < 28 or math.floor(data:byte(1) / 16) ~= 4
            or data:byte(10) ~= 1 then return nil end
    local h = data:byte(1) % 16 * 4
    if h < 20 or #data < h + 8 then return nil end
    local length = data:byte(3) * 256 + data:byte(4)
    if length < h + 8 or #data < length or data:sub(13, 16) ~= route_address(host)
            or data:byte(7) % 64 ~= 0 or data:byte(8) ~= 0
            or route_checksum(data:sub(h + 1, length)) ~= 0 then return nil end
    local kind, code = data:byte(h + 1, h + 2)
    local tag = route_word(id)
    if kind == 0 and code == 0 and host == ip and data:sub(h + 5, h + 6) == tag
            and data:sub(h + 9, length) == "geomate-route" then
        return true, data:byte(h + 7) * 256 + data:byte(h + 8)
    end
    if kind ~= 11 or code ~= 0 then return nil end
    local inner = h + 8
    if #data < inner + 20 or math.floor(data:byte(inner + 1) / 16) ~= 4 then return nil end
    local ih = data:byte(inner + 1) % 16 * 4
    local echo = inner + ih
    if ih < 20 or length < echo + 8 or data:byte(inner + 10) ~= 1
            or data:byte(inner + 3) * 256 + data:byte(inner + 4) < ih + 8
            or data:byte(inner + 7) % 64 ~= 0 or data:byte(inner + 8) ~= 0
            or data:sub(inner + 17, inner + 20) ~= route_address(ip)
            or data:byte(echo + 1) ~= 8 or data:byte(echo + 2) ~= 0
            or data:sub(echo + 5, echo + 6) ~= tag then return nil end
    return false, data:byte(echo + 7) * 256 + data:byte(echo + 8)
end

local function measure_route(ip, hint)
    local sock
    local ok, result, next_hint, observed = pcall(function()
        sock = nixio.socket("inet", "raw", "icmp")
        if not sock or not sock:setsockopt("ip", "hdrincl", 1) or not sock:setblocking(false) then
            return { error = "unsupported" }
        end
        local started = route_uptime()
        if not started then return { error = "clock" } end
        local previous, deadline, sequence, received = started, started + 7, 0, 0
        local fault, best
        local id = nixio.getpid() % 65536
        local pollset = {{ fd = sock, events = nixio.poll_flags("in") }}
        -- The probes by sequence number: { ttl, sent, sent_wall, answered }
        local probes = {}
        local function clock()
            local now = route_uptime()
            if not now or now < previous then fault = "clock"; return deadline end
            previous = now
            return now
        end
        local function wall()
            local sec, usec = nixio.gettimeofday()
            return sec * 1000 + usec / 1000
        end
        local function send(ttl)
            local sent = clock()
            if fault or sent >= deadline or sequence >= 28 or received >= 512 then return false end
            sequence = sequence + 1
            local packet = route_packet(ip, id, sequence, ttl)
            probes[sequence] = { ttl = ttl, sent = sent, sent_wall = wall() }
            if sock:sendto(packet, ip, 0) ~= #packet then fault = "internal"; return false end
            return true
        end
        -- Reads replies until the uptime limit or until done(). A reply counts for its own
        -- probe, also while a later one waits. best: the echo of the server at the lowest TTL,
        -- else the reply from the deepest TTL
        local function collect(limit, done)
            limit = math.min(limit, deadline)
            while not fault and not done() do
                local now = clock()
                if now >= limit or received >= 512 then break end
                local ready = nixio.poll(pollset, math.max(1, math.ceil((limit - now) * 1000)))
                if ready == nil then fault = "internal"; break end
                if not ready or ready <= 0 then break end
                local data, host = sock:recvfrom(2048)
                received = received + 1
                local at, at_wall = clock(), wall()
                local endpoint, seq = route_reply(data, host, ip, id)
                local probe = endpoint ~= nil and probes[seq]
                if probe and not probe.answered and at - probe.sent <= ROUTE_WAIT then
                    probe.answered = true
                    local rtt = at_wall - probe.sent_wall
                    -- /proc/uptime has 10 ms resolution. Reject wall-clock steps rather
                    -- than displaying negative or implausible RTT after time correction.
                    if rtt < 0 or math.abs(rtt - (at - probe.sent) * 1000) > 25 then
                        fault = "clock"; break
                    end
                    if not best or (endpoint and (not best.endpoint or probe.ttl < best.ttl))
                            or (not endpoint and not best.endpoint and probe.ttl > best.ttl) then
                        best = { rtt = rtt, responder = host, ttl = probe.ttl, endpoint = endpoint,
                            measured_at = math.floor(at_wall), observed = at }
                    end
                end
            end
        end
        if not hint then
            -- ROUTE_BATCH TTLs at once. A reply from the deepest TTL of the batch shows that the
            -- route goes on, so the next batch does not wait for silent hops. Only an echo of the
            -- server ends the search: a run of silent hops longer than a batch is common in front
            -- of cloud servers
            for first = 1, 24, ROUTE_BATCH do
                local last = first + ROUTE_BATCH - 1
                for ttl = first, last do
                    if not send(ttl) then break end
                end
                collect(clock() + ROUTE_WAIT, function()
                    return best and (best.endpoint or best.ttl >= last)
                end)
                -- The server's hop is the lowest TTL with an echo: wait up to ROUTE_GRACE s while
                -- a lower TTL of the batch has no reply yet
                if best and best.endpoint then
                    collect(clock() + ROUTE_GRACE, function()
                        for _, probe in pairs(probes) do
                            if probe.ttl >= first and probe.ttl < best.ttl and not probe.answered then
                                return false
                            end
                        end
                        return true
                    end)
                end
                if fault or clock() >= deadline or (best and best.endpoint) then break end
            end
        else
            -- One probe per refresh; a second one only when the first has no reply after
            -- ROUTE_RETRY s, while a late reply to the first still counts
            local function replied() return best ~= nil end
            if send(hint) then collect(clock() + ROUTE_RETRY, replied) end
            if not best and send(hint) then collect(clock() + ROUTE_WAIT, replied) end
        end
        if fault then return { error = fault } end
        if not best then return { status = "no_reply", measured_at = now_ms() } end
        return { status = "ok", rtt = math.floor(best.rtt * 1000 + 0.5) / 1000,
            responder = best.responder, ttl = best.ttl, endpoint = best.endpoint,
            measured_at = best.measured_at }, best.ttl, best.observed
    end)
    if sock then sock:close() end
    if not ok then return { error = "internal" } end
    return result, next_hint, observed
end

local function load_route_state(now)
    local f = io.open(ROUTE_DIR .. "/state.json", "r")
    local content = f and f:read(16385)
    if f then f:close() end
    local state = content and #content <= 16384 and jsonc.parse(content) or {}
    if type(state) ~= "table" then state = {} end
    if type(state.entries) ~= "table" then state.entries = {} end
    if type(state.last_attempt) ~= "number" or state.last_attempt > now then state.last_attempt = nil end
    local entries = {}
    for ip, entry in pairs(state.entries) do
        if type(ip) == "string" and ip_number(ip) and type(entry) == "table"
                and type(entry.at) == "number" and entry.at <= now and now - entry.at <= 300
                and type(entry.discovered) == "number" and entry.discovered <= now then
            entries[#entries + 1] = { ip = ip, entry = entry }
        end
    end
    table.sort(entries, function(a, b) return a.entry.at > b.entry.at end)
    state.entries = {}
    for i = 1, math.min(#entries, 20) do state.entries[entries[i].ip] = entries[i].entry end
    return state
end

local function save_route_state(state)
    local path = ROUTE_DIR .. "/state.json"
    local tmp = path .. "." .. nixio.getpid()
    local f = io.open(tmp, "w")
    if not f then return false end
    local written = f:write(jsonc.stringify(state))
    local closed = f:close()
    if written and closed and os.rename(tmp, path) then return true end
    os.remove(tmp)
    return false
end

local function route_response(ip, entry, now, cached)
    local reply = {}
    for key, value in pairs(entry.result) do reply[key] = value end
    reply.ip, reply.method, reply.cached = ip, "route", cached
    reply.age_ms = math.floor(math.max(0, now - (entry.observed or entry.at)) * 1000)
    reply.refresh_after_ms = math.ceil(math.max(0, ROUTE_GAP - (now - entry.at)) * 1000)
    return reply
end

local function get_server_route(args)
    args = type(args) == "table" and args or {}
    local ip, prefix = args.ip, filter_set_name(args.filter)
    if not prefix then return { error = "invalid_filter" } end
    if type(ip) ~= "string" or not ip_number(ip) or not is_public_ip(ip, router_addresses()) then
        return { error = "invalid_target" }
    end
    local first, second = ip:match("^(%d+)%.(%d+)%.")
    if tonumber(first) == 100 and tonumber(second) >= 64 and tonumber(second) <= 127 then
        return { error = "invalid_target" }
    end
    -- _ui_dynamic first: it holds the servers of the last 10 s, _dynamic and _rx those of the
    -- last hour, which can be tens of thousands. Each listing is read to its end before the next
    if not (set_lists(nft_list_set(prefix .. "_ui_dynamic"), ip)
            or set_lists(nft_list_set(prefix .. "_dynamic"), ip)
            or set_lists(nft_list_set(prefix .. "_rx"), ip)) then
        return { error = "unknown_target" }
    end
    require("nixio.fs").mkdirr(ROUTE_DIR)
    local lock = nixio.open(ROUTE_DIR .. "/.lock", "w", "600")
    if not lock then return { error = "busy" } end
    if not lock:lock("tlock") then lock:close(); return { error = "busy" } end
    -- The descriptor stays locked through measurement and cache publication. Never unlink it.
    local ok, reply = pcall(function()
        local now = route_uptime()
        if not now then return { error = "clock" } end
        local state = load_route_state(now)
        local entry = state.entries[ip]
        if entry and type(entry.result) == "table" and now - entry.at < ROUTE_GAP then
            return route_response(ip, entry, now, true)
        end
        if state.last_attempt and now - state.last_attempt < ROUTE_GAP then
            return { error = "rate_limited", retry_after_ms = math.ceil((ROUTE_GAP - (now - state.last_attempt)) * 1000) }
        end
        local hint = entry and entry.hint
        if type(hint) ~= "number" or hint < 1 or hint > 24 or hint % 1 ~= 0
                or now - entry.discovered >= ROUTE_HINT_AGE then hint = nil end
        if entry and not hint and now - entry.discovered < ROUTE_REDISCOVER then
            return { error = "rate_limited", retry_after_ms = math.ceil((ROUTE_REDISCOVER - (now - entry.discovered)) * 1000) }
        end
        if not entry then
            local count, oldest, oldest_time = 0, nil, now
            for other, value in pairs(state.entries) do
                count = count + 1
                if value.at <= oldest_time then oldest, oldest_time = other, value.at end
            end
            if count >= 20 then state.entries[oldest] = nil end
            entry = { at = now, discovered = now }
            state.entries[ip] = entry
        end
        if not hint then entry.discovered = now end
        state.last_attempt = now
        if not save_route_state(state) then return { error = "internal" } end
        local result, next_hint, observed = measure_route(ip, hint)
        local finished = route_uptime()
        if not finished or finished < now then return { error = "clock" } end
        state.last_attempt, entry.at = finished, finished
        if not result.error then
            entry.result, entry.observed = result, observed or finished
            -- On a failed hint, retry it until rediscovery is allowed; the next request
            -- can then discover again without adding a second trace to this job.
            entry.hint = next_hint or (hint and finished - entry.discovered < ROUTE_REDISCOVER and hint or nil)
        else
            entry.result, entry.observed = nil, nil
        end
        if not save_route_state(state) then return { error = "internal" } end
        if result.error then return result end
        return route_response(ip, entry, finished, false)
    end)
    lock:close()
    return ok and reply or { error = "internal" }
end

-- Function to check if an element is in a table
function table_contains(tbl, element)
    for _, value in ipairs(tbl) do
        if value == element then
            return true
        end
    end
    return false
end

-- A version marker as the updater stamps it: 'dev', a release such as 1.2.0 or a commit hash
local function valid_version(v)
    return v == "dev" or v:match("^%d+%.%d+%.%d+$") ~= nil
        or (#v >= 7 and #v <= 40 and v:match("^[0-9a-f]+$") ~= nil)
end

-- An update channel: release, snapshot, branch=<name> or commit=<hash>
local function valid_channel(c)
    return c == "release" or c == "snapshot" or c:match("^branch=[%w_.%-]+$") ~= nil
        or c:match("^commit=[0-9a-f]+$") ~= nil
end

-- The first value of each marker line in a file: { key = value } for patterns { key = pattern }.
-- Reading stops once every marker is found; the updater stamps them at the top of the file
local function read_markers(path, patterns)
    local found, missing = {}, 0
    for _ in pairs(patterns) do missing = missing + 1 end
    local f = io.open(path, "r")
    if not f then
        return found
    end
    for line in f:lines() do
        for key, pattern in pairs(patterns) do
            local value = found[key] == nil and line:match(pattern)
            if value then
                found[key] = value
                missing = missing - 1
            end
        end
        if missing == 0 then
            break
        end
    end
    f:close()
    return found
end

-- Versions and update channels of the installed files, what check_version reports as 'Current
-- version': VERSION and UPD_CHANNEL of the init script, UI_VERSION and UI_UPD_CHANNEL of view.js,
-- as the updater stamps them. A missing file or line or an invalid value leaves its field out;
-- nil when none is known
local function installed_versions()
    local backend = read_markers("/etc/init.d/geomate", {
        version = '^%s*VERSION%s*=%s*"([^"]*)"',
        channel = '^%s*UPD_CHANNEL%s*=%s*"([^"]*)"'
    })
    local frontend = read_markers("/www/luci-static/resources/view/geomate/view.js", {
        version = "^%s*const%s+UI_VERSION%s*=%s*'([^']*)'",
        channel = "^%s*const%s+UI_UPD_CHANNEL%s*=%s*'([^']*)'"
    })
    local installed = {
        backend = backend.version and valid_version(backend.version) and backend.version or nil,
        backend_channel = backend.channel and valid_channel(backend.channel) and backend.channel or nil,
        frontend = frontend.version and valid_version(frontend.version) and frontend.version or nil,
        frontend_channel = frontend.channel and valid_channel(frontend.channel) and frontend.channel or nil
    }
    return next(installed) and installed or nil
end

-- Flow offloading of the firewall is on: 'flow_offloading' of the first 'defaults' section, the
-- one fw4 reads, with fw4's true values. Hardware offloading needs it too. Offloaded packets skip
-- the prerouting rules that fill _ui_dynamic and count in _dynamic, so a server shows as live
-- only at the start of a connection. Read only; no firewall config counts as off
local function flow_offloading()
    local on = false
    uci:foreach('firewall', 'defaults', function(s)
        local v = s.flow_offloading
        on = (v == '1' or v == 'on' or v == 'true' or v == 'yes')
        return false
    end)
    return on
end

-- 'nft -t list table inet geomate': the table without set elements, about 1.5 KB where the full
-- listing runs to hundreds of KB with large IP lists. '' without the table, nil if nft could not
-- be started. Enough to tell whether the table exists and to count its sets
local function nft_table_terse()
    local handle = io.popen("nft -t list table inet geomate 2>/dev/null")
    if not handle then
        return nil
    end
    local result = handle:read("*a") or ""
    handle:close()
    return result
end

-- Get service status information
local function get_service_status()
    local status = {
        running = false,
        loading = false,
        pid = nil,
        autostart = false,
        config_enabled = false,
        operational_mode = "dynamic",
        debug_level = 0,
        nft_active = false,
        nft_sets_count = 0,
        filters = {},
        nft_errors = {}
    }

    -- Check if filters are currently loading
    local loading_file = nixio.fs.stat("/tmp/geomate_loading")
    status.loading = (loading_file ~= nil)

    -- Check if service is running
    local pid_file = io.open("/var/run/geomate.pid", "r")
    if pid_file then
        local pid = pid_file:read("*l")
        pid_file:close()
        if pid then
            status.pid = tonumber(pid)
            -- Check if process is actually running
            local check = io.popen("kill -0 " .. pid .. " 2>/dev/null && echo running")
            if check then
                local result = check:read("*l")
                check:close()
                status.running = (result == "running")
            end
        end
    end

    -- Check autostart
    local autostart_check = io.popen("/etc/init.d/geomate enabled && echo enabled 2>/dev/null")
    if autostart_check then
        local result = autostart_check:read("*l")
        autostart_check:close()
        status.autostart = (result == "enabled")
    end

    -- Load UCI config
    uci:load('geomate')
    status.config_enabled = (uci:get('geomate', 'global', 'enabled') == '1')
    status.operational_mode = uci:get('geomate', 'global', 'operational_mode') or 'dynamic'
    status.debug_level = tonumber(uci:get('geomate', 'global', 'debug_level')) or 0

    -- Check nftables status and count the sets, as 'grep -c' counted the lines of the full
    -- listing: one terse listing instead of two full ones
    local nft_table = nft_table_terse()
    if nft_table then
        status.nft_active = (nft_table ~= "")
        for line in nft_table:gmatch("[^\n]+") do
            if line:find("set geomate_", 1, true) then
                status.nft_sets_count = status.nft_sets_count + 1
            end
        end
    end

    -- Get filter information. No element counts: no view reads them, and counting listed the
    -- _allowed and _blocked sets of every enabled filter on each status poll (13k elements in
    -- a CoD _blocked set are about 100 ms and 19 MB of nft memory on an Intel N100)
    uci:foreach('geomate', 'geo_filter', function(s)
        table.insert(status.filters, {
            name = s.name,
            enabled = (s.enabled == '1')
        })
    end)

    -- Get recent nft errors (last 5 lines)
    local error_log = io.open("/tmp/geomate_nft_errors.log", "r")
    if error_log then
        local lines = {}
        for line in error_log:lines() do
            table.insert(lines, line)
        end
        error_log:close()
        -- Get last 5 errors
        local start = math.max(1, #lines - 4)
        for i = start, #lines do
            table.insert(status.nft_errors, lines[i])
        end
    end

    status.capabilities = backend_capabilities()
    -- The page checks for updates again when these change, and asks for a reload when its own
    -- UI_VERSION differs from the installed one
    status.installed = installed_versions()
    -- The page notes it at the connections table
    status.flow_offloading = flow_offloading()

    return status
end

-- Run health check and return structured results
local function run_health_check()
    local health = {
        healthy = true,
        loading = false,
        errors = 0,
        checks = {}
    }

    -- Check 0: Loading status (informational, not an error)
    local loading_file = nixio.fs.stat("/tmp/geomate_loading")
    health.loading = (loading_file ~= nil)
    if health.loading then
        health.checks.loading = { status = "info", message = "Filters are being loaded - please wait" }
    else
        health.checks.loading = { status = "ok", message = "Not loading" }
    end

    -- Check 1: Config file
    local config_file = io.open("/etc/config/geomate", "r")
    if config_file then
        config_file:close()
        health.checks.config = { status = "ok", message = "Config file exists" }
    else
        health.checks.config = { status = "error", message = "Config file missing" }
        health.errors = health.errors + 1
    end

    -- Check 2: Required files
    local required_files = {
        "/etc/geomate.sh",
        "/etc/geolocate.sh",
        "/etc/geomate_trigger.sh"
    }
    local files_ok = true
    local missing_files = {}
    for _, file in ipairs(required_files) do
        local f = io.open(file, "r")
        if f then
            f:close()
        else
            files_ok = false
            table.insert(missing_files, file)
        end
    end
    if files_ok then
        health.checks.files = { status = "ok", message = "All required files present" }
    else
        health.checks.files = { status = "error", message = "Missing files: " .. table.concat(missing_files, ", ") }
        health.errors = health.errors + 1
    end

    -- Check 3: Data directory
    local data_dir = nixio.fs.stat("/etc/geomate.d")
    if data_dir and data_dir.type == "dir" then
        health.checks.datadir = { status = "ok", message = "Data directory exists" }
    else
        health.checks.datadir = { status = "error", message = "Data directory missing" }
        health.errors = health.errors + 1
    end

    -- Check 4: Autostart enabled status
    uci:load('geomate')
    local config_enabled = (uci:get('geomate', 'global', 'enabled') == '1')

    local autostart_check = io.popen("/etc/init.d/geomate enabled && echo enabled 2>/dev/null")
    local autostart = false
    if autostart_check then
        local result = autostart_check:read("*l")
        autostart_check:close()
        autostart = (result == "enabled")
    end

    if config_enabled and autostart then
        health.checks.service = { status = "ok", message = "Autostart enabled" }
    elseif not config_enabled and not autostart then
        health.checks.service = { status = "info", message = "Autostart disabled" }
    else
        health.checks.service = { status = "warning", message = "Inconsistent state: config=" .. tostring(config_enabled) .. ", autostart=" .. tostring(autostart) }
    end

    -- Check 5: nftables table (only if service is enabled)
    if config_enabled then
        local result = nft_table_terse()
        if result then
            if result ~= "" then
                health.checks.nft = { status = "ok", message = "nftables table active" }
            else
                health.checks.nft = { status = "error", message = "nftables table not active" }
                health.errors = health.errors + 1
            end
        end

        -- Check 6: Process running
        local pid_file = io.open("/var/run/geomate.pid", "r")
        if pid_file then
            local pid = pid_file:read("*l")
            pid_file:close()
            if pid then
                local check = io.popen("kill -0 " .. pid .. " 2>/dev/null && echo running")
                if check then
                    local result = check:read("*l")
                    check:close()
                    if result == "running" then
                        health.checks.process = { status = "ok", message = "Process running (PID: " .. pid .. ")" }
                    else
                        health.checks.process = { status = "error", message = "Process not running (stale PID)" }
                        health.errors = health.errors + 1
                    end
                end
            end
        else
            health.checks.process = { status = "error", message = "Process not running" }
            health.errors = health.errors + 1
        end
    else
        health.checks.nft = { status = "info", message = "Skipped (service disabled)" }
        health.checks.process = { status = "info", message = "Skipped (service disabled)" }
    end

    -- Check 7: nft error log
    local error_log = io.open("/tmp/geomate_nft_errors.log", "r")
    if error_log then
        local content = error_log:read("*a")
        error_log:close()
        if content and content ~= "" then
            health.checks.nft_errors = { status = "warning", message = "nft error log has entries" }
        else
            health.checks.nft_errors = { status = "ok", message = "No nft errors logged" }
        end
    else
        health.checks.nft_errors = { status = "ok", message = "No nft error log" }
    end

    health.healthy = (health.errors == 0)
    return health
end

-- A full geolocation run (manual or daily) holds this lock: its PID on line 1 and, if the
-- backend writes it, its start time (Unix time) on line 2. Read only with the backend token
-- geolocate_status: older backends create it empty and delete it when the first run ends
local GEOLOCATION_LOCK = "/tmp/geomate/geolocation.lock"

-- Whether a full geolocation run is going on: true plus its start time while the PID of the
-- lock is alive and a geolocate.sh; false without a lock or with a stale one; nil (unknown)
-- for a lock without PID, as older backends write it
local function geolocation_run()
    local f = io.open(GEOLOCATION_LOCK, "r")
    if not f then
        return false
    end
    local pid, started = f:read("*l"), f:read("*l")
    f:close()
    pid = pid and pid:match("^%s*(%d+)%s*$")
    if not pid then
        return nil
    end
    local proc = io.open("/proc/" .. pid .. "/cmdline", "r")
    local cmdline = proc and proc:read("*a") or ""
    if proc then
        proc:close()
    end
    if not cmdline:find("geolocate.sh", 1, true) then
        return false
    end
    started = tonumber(started and started:match("^%s*(%d+)%s*$"))
    if not started then
        local st = nixio.fs.stat(GEOLOCATION_LOCK)
        started = st and st.mtime
    end
    return true, started
end

-- Main function of the RPC script
local methods = {
    getGeomateConnections = {
        -- rpcd takes the type of an argument from the sample value: a boolean
        args = { counters = true },
        call = function(args)
            local connections = get_all_connections(type(args) == "table" and args.counters == true)
            return { connections = connections }
        end
    },
    getAllowedIPs = {
        call = function()
            load_cache()
            local allowed_ips, changed = get_allowed_ips()
            if changed then
                save_cache()
            end
            return { allowed_ips = allowed_ips }
        end
    },
    getKnownServers = {
        args = { sid = 'string' },
        call = function(args)
            return get_known_servers(type(args) == "table" and args.sid or nil)
        end
    },
    getServerSample = {
        args = { filter = 'string', ip = 'string', ping = true },
        call = function(args)
            return get_server_sample(args)
        end
    },
    getServerRoute = {
        args = { filter = 'string', ip = 'string' },
        call = get_server_route
    },
    getStatus = {
        call = function()
            local status = get_service_status()
            return { status = status }
        end
    },
    getHealthCheck = {
        call = function()
            local health = run_health_check()
            return { health = health }
        end
    },
    getGeolocationStatus = {
        call = function()
            -- Read pre-computed geolocation status from JSON file
            -- geomate.sh writes this file at start and after every check of dynamic and monitor
            -- mode (global check_interval, 1800 s by default)
            local status_file = "/etc/geomate.d/runtime/geolocation_status.json"
            local nft_error_file = "/tmp/geomate_nft_errors.log"
            local f = io.open(status_file, "r")
            local data = nil
            
            if f then
                local content = f:read("*a")
                f:close()
                data = jsonc.parse(content)
                if data then
                    -- Add human-readable timestamps
                    local now = os.time()
                    data.last_update_ago = now - (data.timestamp or now)
                    data.next_cycle_in = (data.next_cycle or now) - now
                    if data.next_cycle_in < 0 then data.next_cycle_in = 0 end
                    
                    -- Frequent geolocation timing
                    if data.geolocation then
                        data.geolocation.last_run_ago = now - (data.geolocation.last_run or 0)
                        data.geolocation.next_run_in = (data.geolocation.next_run or now) - now
                        if data.geolocation.next_run_in < 0 then data.geolocation.next_run_in = 0 end
                    end
                    
                    -- Daily geolocation timing
                    if data.geolocation_daily then
                        data.geolocation_daily.last_run_ago = now - (data.geolocation_daily.last_run or 0)
                        data.geolocation_daily.next_run_in = (data.geolocation_daily.next_run or now) - now
                        if data.geolocation_daily.next_run_in < 0 then data.geolocation_daily.next_run_in = 0 end
                    end
                end
            end
            
            -- Initialize data if not loaded
            if not data then
                data = {
                    timestamp = 0,
                    operational_mode = "unknown",
                    geolocation_mode = "unknown",
                    message = "No geolocation data available yet. Start the service and wait for the first cycle."
                }
            end
            
            -- Check for NFT errors and extract affected filter names
            data.nft_errors = false
            data.nft_error_filters = {}
            local ef = io.open(nft_error_file, "r")
            if ef then
                local error_content = ef:read("*a")
                ef:close()
                if error_content and #error_content > 0 then
                    data.nft_errors = true
                    -- Extract filter names from set references like @geomate_Call_of_Duty_allowed
                    -- (spaces in the name appear as '_', so strip the set suffix instead)
                    local seen = {}
                    for set_name in error_content:gmatch("@geomate_([%w_.%-]*[%w_])") do
                        local filter_name = set_name:match("^(.+)_ui_dynamic$") or set_name:match("^(.+)_%a+$")
                        if filter_name and not seen[filter_name] then
                            seen[filter_name] = true
                            table.insert(data.nft_error_filters, filter_name)
                        end
                    end
                end
            end
            
            -- The Geo Filters page offers several Source IP entries only with src_ip_multi
            data.capabilities = backend_capabilities()
            
            -- A full geolocation run from the lock. No fields while unknown: a backend without
            -- geolocate_status keeps no PID lock, so a missing lock tells nothing about a run
            local running, started
            for _, token in ipairs(data.capabilities) do
                if token == "geolocate_status" then
                    running, started = geolocation_run()
                end
            end
            if running ~= nil then
                data.geolocation_running = running
                if running and started then
                    data.geolocation_started = started
                    data.geolocation_running_for = math.max(0, os.time() - started)
                end
            end
            
            return { status = data }
        end
    }
}

-- Handle RPC calls
if arg[1] == "list" then
    local rv = {}
    for k, v in pairs(methods) do
        rv[k] = v.args or {}
    end
    print((jsonc.stringify(rv):gsub(":%[%]", ":{}")))
elseif arg[1] == "call" then
    local args = jsonc.parse(io.stdin:read("*a"))
    local method = methods[arg[2]]
    if method then
        local result = method.call(args)
        print(jsonc.stringify(result))
        os.exit(result.code or 0)
    else
        print(jsonc.stringify({ error = "Method not found" }))
        os.exit(1)
    end
end
