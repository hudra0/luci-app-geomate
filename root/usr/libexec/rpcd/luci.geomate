#!/usr/bin/env lua

local jsonc = require "luci.jsonc"
local uci = require "luci.model.uci".cursor()
local nixio = require "nixio"

local cache_file = "/tmp/geomate_ip_cache.json"
local cache = {}

-- Load the cache from file
local function load_cache()
    local f = io.open(cache_file, "r")
    if f then
        local content = f:read("*a")
        cache = jsonc.parse(content) or {}
        f:close()
    end
end

-- Save the cache to file
local function save_cache()
    local f = io.open(cache_file, "w")
    if f then
        f:write(jsonc.stringify(cache))
        f:close()
    end
end

-- Text fields of an ip-api result that the connections table and the map popups show.
-- Additive: cache entries written before they existed carry lat/lon only and stay valid
local GEO_TEXT_FIELDS = { "country", "countryCode", "city", "isp", "org" }

-- Geo data of the filters: <filter name>_geo_data.json, JSON lines from ip-api
local GEO_DATA_DIR = "/etc/geomate.d"

-- Filter names the backend supports in nft set names and geo data file names. A name that
-- matches contains no '/' and no shell quote
local FILTER_NAME_PATTERN = "^[%w_ .%-]+$"

-- Cache entry of one geo data line for an IP, or nil if the line has no position
local function geo_entry(line, ip)
    local data = jsonc.parse(line)
    if not (data and data.query == ip and data.lat and data.lon) then
        return nil
    end

    local entry = { lat = data.lat, lon = data.lon }
    for _, k in ipairs(GEO_TEXT_FIELDS) do
        if type(data[k]) == "string" and data[k] ~= "" then
            entry[k] = data[k]
        end
    end
    return entry
end

-- One pass over the geo data file of a filter for the IPs in 'wanted' ({ [ip] = true }).
-- A hit is cached and leaves 'wanted'. Only a line whose "query" is wanted gets a JSON parse;
-- geolocate.sh writes the compact "query":"<ip>" form, at the end of the line. Plain finds
-- only, an unanchored pattern would be tried at every position of the line: for one IP its
-- whole key, else the key name and the address right behind it
local function scan_geo_file(name, wanted)
    -- A matching name contains no '/', so the path stays in the directory
    local f = next(wanted) and type(name) == "string" and name:match(FILTER_NAME_PATTERN)
        and io.open(GEO_DATA_DIR .. "/" .. name .. "_geo_data.json", "r")
    if not f then
        return
    end

    local only = next(wanted, next(wanted)) == nil and next(wanted)
    local needle = only and ('"query":"' .. only .. '"')
    for line in f:lines() do
        local ip
        if needle then
            ip = line:find(needle, 1, true) and only
        else
            local p = line:find('"query":"', 1, true)
            ip = p and line:match('^([%d%.]+)"', p + 9)
        end
        local entry = ip and wanted[ip] and geo_entry(line, ip)
        if entry then
            cache[ip] = entry
            wanted[ip] = nil
            if not next(wanted) then
                break
            end
        end
    end
    f:close()
end

-- Looks up the IPs without a cache entry, all of one request together: wanted is
-- { [filter name] = { [ip] = true } }. First each filter's own geo data file for its IPs, then
-- the files of the other enabled filters for what is still missing, until all are found; an
-- untracked server is a miss in almost every file, so files of disabled or removed filters are
-- not read. Each file is read at most twice per request. Misses are cached too, until the
-- next service start or frequent geolocation batch deletes the cache file.
-- The caller loads the geomate config. Returns true if the cache changed
local function lookup_geo(wanted)
    local missing, own_file = {}, {}

    for name, ips in pairs(wanted) do
        local todo = {}
        for ip in pairs(ips) do
            if not cache[ip] and not own_file[ip] then
                todo[ip] = true
                own_file[ip] = name
            end
        end
        scan_geo_file(name, todo)
        for ip in pairs(todo) do
            missing[ip] = true
        end
    end

    if next(missing) then
        local scanned = {}
        uci:foreach('geomate', 'geo_filter', function(s)
            local name = s.name
            if s.enabled ~= '1' or type(name) ~= "string" or scanned[name] or not next(missing) then
                return
            end
            scanned[name] = true

            -- The own file of an IP was read above
            local todo = {}
            for ip in pairs(missing) do
                if own_file[ip] ~= name then
                    todo[ip] = true
                end
            end
            scan_geo_file(name, todo)
            for ip in pairs(missing) do
                if cache[ip] then
                    missing[ip] = nil
                end
            end
        end)
    end

    for ip in pairs(missing) do
        cache[ip] = {}
    end
    return next(own_file) ~= nil
end

-- A number with a leading zero ('012', '024'), which nft reads as octal: an entry with one is
-- not the address or prefix it seems to be, so it counts as nothing
local function has_leading_zero(s)
    return s:find("^0%d") or s:find("%.0%d")
end

-- An IPv4 address as a number, nil for anything else (also for an octet with a leading zero)
local function ip_number(ip)
    local a, b, c, d = ip:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
    a, b, c, d = tonumber(a), tonumber(b), tonumber(c), tonumber(d)
    if not a or a > 255 or b > 255 or c > 255 or d > 255 or has_leading_zero(ip) then
        return nil
    end
    return ((a * 256 + b) * 256 + c) * 256 + d
end

-- Address sets as nft holds them: { ips = { [address] = true }, ranges = { { lo, hi }, … } }
local function new_set()
    return { ips = {}, ranges = {} }
end

-- Adds a set element or an allowed_ip entry: an address, a prefix (a.b.c.d/nn) or a range
-- (a.b.c.d-e.f.g.h). An address goes in as written, without a parse: set_has() looks up the
-- dotted form nft prints, which an entry with a leading zero, a '!' or a typo never equals.
-- A prefix or range that does not parse is skipped
local function add_element(set, element)
    if not element:find("[/%-]") then
        set.ips[element] = true
        return
    end

    local addr, bits = element:match("^([%d%.]+)/(%d+)$")
    if addr then
        local n = ip_number(addr)
        if n and not has_leading_zero(bits) and tonumber(bits) <= 32 then
            local size = 2 ^ (32 - tonumber(bits))
            local lo = n - n % size
            table.insert(set.ranges, { lo, lo + size - 1 })
        end
        return
    end

    local from, to = element:match("^([%d%.]+)%-([%d%.]+)$")
    if from then
        local lo, hi = ip_number(from), ip_number(to)
        if lo and hi and lo <= hi then
            table.insert(set.ranges, { lo, hi })
        end
    end
end

-- Whether a set contains an address (dotted, as nft prints it): the hash first, then the few
-- prefixes and ranges
local function set_has(set, ip)
    if set.ips[ip] then
        return true
    end
    local n = next(set.ranges) and ip_number(ip)
    if not n then
        return false
    end
    for _, r in ipairs(set.ranges) do
        if n >= r[1] and n <= r[2] then
            return true
        end
    end
    return false
end

-- Public IPv4 addresses as geomate.sh's is_valid_public_ip sees them (CGNAT 100.64/10 counts
-- as public), without the router's own addresses (own: { [ip] = true })
local function is_public_ip(ip, own)
    local a, b = ip:match("^(%d+)%.(%d+)%.")
    a, b = tonumber(a), tonumber(b)
    if not a or own[ip] then
        return false
    end
    return not (a == 0 or a == 10 or a == 127 or a >= 224
        or (a == 169 and b == 254)
        or (a == 172 and b >= 16 and b <= 31)
        or (a == 192 and b == 168))
end

-- IPv4 addresses of the router's interfaces, read without a fork. A filter without Source IP
-- also sees traffic to the router itself, e.g. to its WAN address
local function router_addresses()
    local own = {}
    for _, ifa in ipairs(nixio.getifaddrs() or {}) do
        if ifa.family == "inet" and ifa.addr then
            own[ifa.addr] = true
        end
    end
    return own
end

-- Helper function to parse port lists and ranges
local function parse_ports(port_str)
    local ports = {}
    for part in string.gmatch(port_str, '([^,]+)') do
        if string.find(part, '-') then
            local start_port, end_port = string.match(part, '(%d+)%-(%d+)')
            if start_port and end_port then
                for p = tonumber(start_port), tonumber(end_port) do
                    ports[p] = true
                end
            else
                local port = tonumber(part)
                if port then
                    ports[port] = true
                end
            end
        else
            local port = tonumber(part)
            if port then
                ports[port] = true
            end
        end
    end
    return ports
end

-- Check if a port is within the port list or range
local function port_matches(port, port_set)
    if port_set["any"] then
        return true
    end
    return port_set[tonumber(port)] or false
end

-- nft set name prefix of a filter, or nil if the name must not reach a shell command.
-- The pattern covers what the backend supports in nft set names and file names
local function filter_set_name(name)
    if type(name) ~= "string" or not name:match(FILTER_NAME_PATTERN) then
        return nil
    end
    return "geomate_" .. (name:gsub(' ', '_'))
end

-- Output of 'nft list set inet geomate <set>', '' if there is none. Only names built by
-- filter_set_name() reach the shell
local function nft_list_set(set_name)
    local handle = io.popen("nft list set inet geomate '" .. set_name .. "' 2>/dev/null")
    if not handle then
        return ""
    end
    local result = handle:read("*a") or ""
    handle:close()
    return result
end

-- A cache entry for one row of an answer, with or without lat/lon. Rows never share a table:
-- luci.jsonc writes a table that appears twice in one answer as null, and an IP can be an
-- allowed IP of several filters
local function geo_copy(geo, with_position)
    local copy = with_position and { lat = geo.lat, lon = geo.lon } or {}
    for _, k in ipairs(GEO_TEXT_FIELDS) do
        copy[k] = geo[k]
    end
    return copy
end

-- The 'elements = { ... }' block of a set, '' for an empty or missing one. Only the block: the
-- header holds the set name, and a filter named e.g. 'Game 1.2.3.4' must not add an element
local function set_elements(set_name)
    return nft_list_set(set_name):match("elements = {(.-)}") or ""
end

-- Packets and bytes of an address in the 'nft list set' output of a set with the counter flag,
-- where each element reads '<ip> counter packets N bytes M'; nil when the address has none.
-- Plain finds from the elements block on, only for the IPs a reply shows: a pattern pass over
-- 2000 elements takes about 7 ms on an Intel N100
local function element_counter(listing, ip)
    local needle = ip .. " counter packets "
    local from = listing:find("elements = {", 1, true)

    while from do
        local p = listing:find(needle, from, true)
        if not p then
            return nil
        end
        -- '45.6.7.8' contains '5.6.7.8': an element starts after a blank or the '{'
        if listing:find("^[%s{]", p - 1) then
            local packets, bytes = listing:match("^(%d+) bytes (%d+)", p + #needle)
            return tonumber(packets), tonumber(bytes)
        end
        from = p + 1
    end
    return nil
end

-- Elements of an _allowed or _blocked set (flags interval): addresses, prefixes and ranges
local function read_set(set_name)
    local set = new_set()
    for element in set_elements(set_name):gmatch("[^%s,]+") do
        add_element(set, element)
    end
    return set
end

-- Addresses in the elements block of a set, as the former grep counted them: a range counts
-- both ends, a prefix its address
local function count_set_addresses(set_name)
    local count = 0
    for _ in set_elements(set_name):gmatch("%d+%.%d+%.%d+%.%d+") do
        count = count + 1
    end
    return count
end

-- allowed_ip of a filter section, split like the backend splits it: list entries only
-- (config_list_foreach), so a hand-written 'option allowed_ip', which arrives as a string,
-- whitelists nothing; an entry can hold several addresses, prefixes or ranges, separated by
-- whitespace or commas (the Allowed IPs field accepts '1.2.3.4 5.6.7.8' as one entry)
local function allowed_ip_list(s)
    local tokens = {}
    if type(s.allowed_ip) == "table" then
        for _, entry in ipairs(s.allowed_ip) do
            for token in tostring(entry):gmatch("[^%s,]+") do
                table.insert(tokens, token)
            end
        end
    end
    return tokens
end

-- Servers the enabled filters see right now (_ui_dynamic), one entry per IP:
-- { ip, filter = <section>, allowed = true (in _allowed), false (in _blocked) or nil }.
-- nil means untracked: not geolocated yet, or the filter has no circles. _allowed wins because
-- the accept rule comes before the drop rule. If several filters see an IP, their rules run in
-- config order: the first filter with a verdict wins. With strict_mode the first filter that
-- sees the IP decides, because its catch-all drop stops an untracked server before any later
-- filter. strict_mode counts in monitor mode too: the table shows what the rules would do.
-- Private and reserved addresses and the router's own addresses are left out.
-- with_counters: also the 'nft list set' output of the _dynamic set of each filter that sees a
-- server, as { [section] = text }; nft lists it while the _allowed and _blocked sets are read
local function get_ui_dynamic_ips(with_counters)
    local entries, by_ip, pipes, listings = {}, {}, {}, {}
    local own = router_addresses()

    uci:load('geomate')
    local strict = uci:get('geomate', 'global', 'strict_mode') == '1'
    -- Static mode has no _dynamic set
    with_counters = with_counters and uci:get('geomate', 'global', 'operational_mode') ~= 'static'
    uci:foreach('geomate', 'geo_filter', function(s)
        local set_name = filter_set_name(s.name)
        if s.enabled ~= '1' or not set_name then
            return
        end

        -- IPs this filter may still claim: new ones, and without strict_mode untracked ones of
        -- an earlier filter
        local candidates = {}
        for ip in set_elements(set_name .. "_ui_dynamic"):gmatch("(%d+%.%d+%.%d+%.%d+)") do
            local entry = by_ip[ip]
            if (not entry or (entry.allowed == nil and not strict)) and is_public_ip(ip, own) then
                table.insert(candidates, ip)
            end
        end
        if #candidates == 0 then
            return
        end

        if with_counters then
            pipes[s['.name']] = io.popen("nft list set inet geomate '" .. set_name .. "_dynamic' 2>/dev/null")
        end
        local allowed = read_set(set_name .. "_allowed")
        local blocked = read_set(set_name .. "_blocked")
        for _, ip in ipairs(candidates) do
            local verdict = nil
            if set_has(allowed, ip) then
                verdict = true
            elseif set_has(blocked, ip) then
                verdict = false
            end

            local entry = by_ip[ip]
            if not entry then
                entry = { ip = ip, filter = s, allowed = verdict }
                by_ip[ip] = entry
                table.insert(entries, entry)
            elseif verdict ~= nil then
                entry.filter, entry.allowed = s, verdict
            end
        end
    end)

    for sid, handle in pairs(pipes) do
        listings[sid] = handle:read("*a") or ""
        handle:close()
    end
    return entries, listings
end

-- Connections from the _ui_dynamic sets of the enabled filters (previously also from conntrack)
-- with the verdict of the filter's nft sets. is_allowed_ip: the IP is in _allowed and in the
-- filter's own allowed_ip, as an address or inside a prefix or range. The set has to agree:
-- nft rejects the whole allowed_ip batch for one '!' entry, and a saved change counts only
-- after the next service start.
-- with_counters (the page asks for them when the backend reports set_counters): packets and
-- bytes the kernel counted for the server in the filter's _dynamic set, since its first packet
-- after the last service start or after an hour without one. Left out when the set has none,
-- as in static mode, which has no _dynamic set
local function get_all_connections(with_counters)
    load_cache()
    local entries, listings = get_ui_dynamic_ips(with_counters)

    local wanted = {}
    for _, e in ipairs(entries) do
        local name = e.filter.name
        wanted[name] = wanted[name] or {}
        wanted[name][e.ip] = true
    end
    local changed = lookup_geo(wanted)

    local connections, whitelists = {}, {}
    for _, e in ipairs(entries) do
        local s = e.filter
        local whitelisted = false
        if e.allowed == true then
            local whitelist = whitelists[s['.name']]
            if not whitelist then
                whitelist = new_set()
                for _, entry in ipairs(allowed_ip_list(s)) do
                    add_element(whitelist, entry)
                end
                whitelists[s['.name']] = whitelist
            end
            whitelisted = set_has(whitelist, e.ip)
        end

        -- No position for an untracked server: older map.html versions draw a connection
        -- without 'allowed' as a blocked marker
        local geo = geo_copy(cache[e.ip] or {}, e.allowed ~= nil)
        local listing = listings[s['.name']]
        local packets, bytes
        if listing then
            packets, bytes = element_counter(listing, e.ip)
        end

        table.insert(connections, {
            src = "unknown",
            dst = e.ip,
            protocol = "unknown",
            sport = "unknown",
            dport = "unknown",
            allowed = e.allowed,
            geo = geo,
            filter_name = s.name,
            is_dynamic = true,        -- Indicates the connection is from a dynamic set
            is_allowed_ip = whitelisted,
            packets = packets,
            bytes = bytes
        })
    end

    if changed then
        save_cache()
    end
    return connections
end

-- Retrieve allowlist IPs with their geo data; entries without a position are left out
local function get_allowed_ips()
    local filters, wanted = {}, {}

    uci:load('geomate')
    uci:foreach('geomate', 'geo_filter', function(s)
        -- A hand-written 'list name' arrives as a table and names no filter
        if s.enabled == '1' and type(s.name or "") == "string" then
            local name, ips = s.name or "", {}
            for _, ip in ipairs(allowed_ip_list(s)) do
                if ip_number(ip) then
                    table.insert(ips, ip)
                    wanted[name] = wanted[name] or {}
                    wanted[name][ip] = true
                end
            end
            table.insert(filters, { name = s.name, ips = ips })
        end
    end)
    local changed = lookup_geo(wanted)

    local allowed_ips = {}
    for _, f in ipairs(filters) do
        for _, ip in ipairs(f.ips) do
            local geo = cache[ip] or {}
            if geo.lat and geo.lon then
                table.insert(allowed_ips, { ip = ip, geo = geo_copy(geo, true), filter = f.name })
            end
        end
    end

    return allowed_ips, changed
end

-- Known servers of a filter for the map (getKnownServers): the positions in its geo data file,
-- counted per position. Cached per filter name under /tmp, never on flash, while the file keeps
-- its inode, size and mtime (geolocate.sh replaces the file with mv)
local KNOWN_SERVERS_CACHE = "/tmp/geomate_known_servers.json"

-- Above this many positions they are merged to 2 decimals (about 1 km), then to 1 and 0 decimals
-- while there are still more, and the answer says approx and the decimals of the last merge. 0
-- decimals leaves at most 181 * 361
local KNOWN_SERVERS_MAX_POINTS = 3000

-- A position as one key: tostring() of the two numbers. -0 + 0 is 0, so 0 and -0 share a key
local function position_key(lat, lon)
    return tostring(lat + 0) .. "," .. tostring(lon + 0)
end

-- The points merged by their position rounded to the given number of decimals; counts add up
local function merge_positions(points, decimals)
    local fmt, merged, by_key = "%." .. decimals .. "f", {}, {}
    for _, p in ipairs(points) do
        local lat = tonumber(string.format(fmt, p[1])) + 0
        local lon = tonumber(string.format(fmt, p[2])) + 0
        local key = position_key(lat, lon)
        local point = by_key[key]
        if point then
            point[3] = point[3] + p[3]
        else
            point = { lat, lon, p[3] }
            by_key[key] = point
            table.insert(merged, point)
        end
    end
    return merged
end

-- One pass over a geo data file: { total, approx, decimals, points = { { lat, lon, n }, … } }
-- (decimals only when approx), nil if it cannot be read. The exact lat/lon text is the key; a
-- line without a valid position counts nowhere. Both fields come from separate matches, without
-- a JSON parse per line
local function count_positions(path)
    local f = io.open(path, "r")
    if not f then
        return nil
    end

    local points, by_text, total = {}, {}, 0
    for line in f:lines() do
        local lat_text = line:match('"lat":(%-?[%d%.]+)')
        local lon_text = lat_text and line:match('"lon":(%-?[%d%.]+)')
        local lat, lon = tonumber(lat_text), tonumber(lon_text)
        if lat and lon and math.abs(lat) <= 90 and math.abs(lon) <= 180 then
            local key = lat_text .. "," .. lon_text
            local point = by_text[key]
            if point then
                point[3] = point[3] + 1
            else
                point = { lat, lon, 1 }
                by_text[key] = point
                table.insert(points, point)
            end
            total = total + 1
        end
    end
    f:close()

    local approx, used = false
    for decimals = 2, 0, -1 do
        if #points <= KNOWN_SERVERS_MAX_POINTS then
            break
        end
        points = merge_positions(points, decimals)
        approx, used = true, decimals
    end
    return { total = total, approx = approx, decimals = used, points = points }
end

-- The known servers cache: { [filter name] = { ino, size, mtime, total, approx, decimals,
-- points } }. An entry written before decimals existed has none, and neither has its answer
local function load_known_servers()
    local f = io.open(KNOWN_SERVERS_CACHE, "r")
    if not f then
        return {}
    end
    local data = jsonc.parse(f:read("*a") or "")
    f:close()
    return type(data) == "table" and data or {}
end

-- Writes the cache through a temp file and a rename, so a parallel call never reads half a file
local function save_known_servers(data)
    local tmp = KNOWN_SERVERS_CACHE .. "." .. nixio.getpid()
    local f = io.open(tmp, "w")
    if not f then
        return
    end
    local ok = f:write(jsonc.stringify(data))
    f:close()
    if not (ok and os.rename(tmp, KNOWN_SERVERS_CACHE)) then
        os.remove(tmp)
    end
end

-- getKnownServers: { total, approx, decimals, points = { { lat, lon, n }, … } } for the
-- geo_filter section sid. Without a geo data file { points = {}, total = 0, missing = true };
-- { error } for an unknown section or a name the backend does not support. Read only, apart
-- from the cache
local function get_known_servers(sid)
    if type(sid) ~= "string" or not sid:match("^[%w_]+$") then
        return { error = "Invalid filter id" }
    end
    uci:load('geomate')
    local s = uci:get_all('geomate', sid)
    if type(s) ~= "table" or s['.type'] ~= 'geo_filter' then
        return { error = "No such filter" }
    end
    local name = s.name
    if type(name) ~= "string" or not name:match(FILTER_NAME_PATTERN) then
        return { error = "Unsupported filter name" }
    end

    -- A matching name contains no '/', so the path stays in the directory
    local path = GEO_DATA_DIR .. "/" .. name .. "_geo_data.json"
    local st = nixio.fs.stat(path)
    if not st or st.type ~= "reg" then
        return { points = {}, total = 0, missing = true }
    end

    local known = load_known_servers()
    local entry = known[name]
    if type(entry) == "table" and entry.ino == st.ino and entry.size == st.size
        and entry.mtime == st.mtime and type(entry.points) == "table" then
        return { total = entry.total, approx = entry.approx, decimals = entry.decimals,
            points = entry.points }
    end

    local result = count_positions(path)
    if not result then
        return { error = "Cannot read the geo data" }
    end

    -- Only entries of configured filters stay in the cache
    local keep = {}
    uci:foreach('geomate', 'geo_filter', function(f)
        if type(f.name) == "string" and type(known[f.name]) == "table" then
            keep[f.name] = known[f.name]
        end
    end)
    keep[name] = { ino = st.ino, size = st.size, mtime = st.mtime,
        total = result.total, approx = result.approx, decimals = result.decimals,
        points = result.points }
    save_known_servers(keep)
    return result
end

-- Function to check if an element is in a table
function table_contains(tbl, element)
    for _, value in ipairs(tbl) do
        if value == element then
            return true
        end
    end
    return false
end

-- Feature tokens of the installed backend: '/etc/geomate.sh capabilities' prints one line of
-- space-separated tokens (fixed command, no input). An older geomate.sh prints its usage and
-- exits 1; any line that is not lowercase tokens counts as no capabilities. Tokens are only
-- added, never renamed. src_ip_multi: Source IP takes several entries and exceptions
local function backend_capabilities()
    local caps = {}
    local handle = io.popen("/etc/geomate.sh capabilities 2>/dev/null")
    if handle then
        local line = handle:read("*l")
        handle:close()
        if line and line:match("^[%l%d_ ]*$") then
            for token in line:gmatch("[%l%d_]+") do
                table.insert(caps, token)
            end
        end
    end
    return caps
end

-- A version marker as the updater stamps it: 'dev', a release such as 1.2.0 or a commit hash
local function valid_version(v)
    return v == "dev" or v:match("^%d+%.%d+%.%d+$") ~= nil
        or (#v >= 7 and #v <= 40 and v:match("^[0-9a-f]+$") ~= nil)
end

-- An update channel: release, snapshot, branch=<name> or commit=<hash>
local function valid_channel(c)
    return c == "release" or c == "snapshot" or c:match("^branch=[%w_.%-]+$") ~= nil
        or c:match("^commit=[0-9a-f]+$") ~= nil
end

-- The first value of each marker line in a file: { key = value } for patterns { key = pattern }.
-- Reading stops once every marker is found; the updater stamps them at the top of the file
local function read_markers(path, patterns)
    local found, missing = {}, 0
    for _ in pairs(patterns) do missing = missing + 1 end
    local f = io.open(path, "r")
    if not f then
        return found
    end
    for line in f:lines() do
        for key, pattern in pairs(patterns) do
            local value = found[key] == nil and line:match(pattern)
            if value then
                found[key] = value
                missing = missing - 1
            end
        end
        if missing == 0 then
            break
        end
    end
    f:close()
    return found
end

-- Versions and update channels of the installed files, what check_version reports as 'Current
-- version': VERSION and UPD_CHANNEL of the init script, UI_VERSION and UI_UPD_CHANNEL of view.js,
-- as the updater stamps them. A missing file or line or an invalid value leaves its field out;
-- nil when none is known
local function installed_versions()
    local backend = read_markers("/etc/init.d/geomate", {
        version = '^%s*VERSION%s*=%s*"([^"]*)"',
        channel = '^%s*UPD_CHANNEL%s*=%s*"([^"]*)"'
    })
    local frontend = read_markers("/www/luci-static/resources/view/geomate/view.js", {
        version = "^%s*const%s+UI_VERSION%s*=%s*'([^']*)'",
        channel = "^%s*const%s+UI_UPD_CHANNEL%s*=%s*'([^']*)'"
    })
    local installed = {
        backend = backend.version and valid_version(backend.version) and backend.version or nil,
        backend_channel = backend.channel and valid_channel(backend.channel) and backend.channel or nil,
        frontend = frontend.version and valid_version(frontend.version) and frontend.version or nil,
        frontend_channel = frontend.channel and valid_channel(frontend.channel) and frontend.channel or nil
    }
    return next(installed) and installed or nil
end

-- Get service status information
local function get_service_status()
    local status = {
        running = false,
        loading = false,
        pid = nil,
        autostart = false,
        config_enabled = false,
        operational_mode = "dynamic",
        debug_level = 0,
        nft_active = false,
        nft_sets_count = 0,
        filters = {},
        nft_errors = {}
    }

    -- Check if filters are currently loading
    local loading_file = nixio.fs.stat("/tmp/geomate_loading")
    status.loading = (loading_file ~= nil)

    -- Check if service is running
    local pid_file = io.open("/var/run/geomate.pid", "r")
    if pid_file then
        local pid = pid_file:read("*l")
        pid_file:close()
        if pid then
            status.pid = tonumber(pid)
            -- Check if process is actually running
            local check = io.popen("kill -0 " .. pid .. " 2>/dev/null && echo running")
            if check then
                local result = check:read("*l")
                check:close()
                status.running = (result == "running")
            end
        end
    end

    -- Check autostart
    local autostart_check = io.popen("/etc/init.d/geomate enabled && echo enabled 2>/dev/null")
    if autostart_check then
        local result = autostart_check:read("*l")
        autostart_check:close()
        status.autostart = (result == "enabled")
    end

    -- Load UCI config
    uci:load('geomate')
    status.config_enabled = (uci:get('geomate', 'global', 'enabled') == '1')
    status.operational_mode = uci:get('geomate', 'global', 'operational_mode') or 'dynamic'
    status.debug_level = tonumber(uci:get('geomate', 'global', 'debug_level')) or 0

    -- Check nftables status
    local nft_check = io.popen("nft list table inet geomate 2>/dev/null")
    if nft_check then
        local result = nft_check:read("*a")
        nft_check:close()
        status.nft_active = (result ~= nil and result ~= "")
    end

    -- Count nft sets
    local nft_sets = io.popen("nft list sets inet geomate 2>/dev/null | grep -c 'set geomate_'")
    if nft_sets then
        local count = nft_sets:read("*l")
        nft_sets:close()
        status.nft_sets_count = tonumber(count) or 0
    end

    -- Get filter information
    uci:foreach('geomate', 'geo_filter', function(s)
        local filter_info = {
            name = s.name,
            enabled = (s.enabled == '1'),
            allowed_count = 0,
            blocked_count = 0
        }

        local set_name = filter_set_name(s.name)
        if filter_info.enabled and status.nft_active and set_name then
            -- Count only the elements: the set header holds the filter name
            filter_info.allowed_count = count_set_addresses(set_name .. "_allowed")
            filter_info.blocked_count = count_set_addresses(set_name .. "_blocked")
        end

        table.insert(status.filters, filter_info)
    end)

    -- Get recent nft errors (last 5 lines)
    local error_log = io.open("/tmp/geomate_nft_errors.log", "r")
    if error_log then
        local lines = {}
        for line in error_log:lines() do
            table.insert(lines, line)
        end
        error_log:close()
        -- Get last 5 errors
        local start = math.max(1, #lines - 4)
        for i = start, #lines do
            table.insert(status.nft_errors, lines[i])
        end
    end

    status.capabilities = backend_capabilities()
    -- The page checks for updates again when these change, and asks for a reload when its own
    -- UI_VERSION differs from the installed one
    status.installed = installed_versions()

    return status
end

-- Run health check and return structured results
local function run_health_check()
    local health = {
        healthy = true,
        loading = false,
        errors = 0,
        checks = {}
    }

    -- Check 0: Loading status (informational, not an error)
    local loading_file = nixio.fs.stat("/tmp/geomate_loading")
    health.loading = (loading_file ~= nil)
    if health.loading then
        health.checks.loading = { status = "info", message = "Filters are being loaded - please wait" }
    else
        health.checks.loading = { status = "ok", message = "Not loading" }
    end

    -- Check 1: Config file
    local config_file = io.open("/etc/config/geomate", "r")
    if config_file then
        config_file:close()
        health.checks.config = { status = "ok", message = "Config file exists" }
    else
        health.checks.config = { status = "error", message = "Config file missing" }
        health.errors = health.errors + 1
    end

    -- Check 2: Required files
    local required_files = {
        "/etc/geomate.sh",
        "/etc/geolocate.sh",
        "/etc/geomate_trigger.sh"
    }
    local files_ok = true
    local missing_files = {}
    for _, file in ipairs(required_files) do
        local f = io.open(file, "r")
        if f then
            f:close()
        else
            files_ok = false
            table.insert(missing_files, file)
        end
    end
    if files_ok then
        health.checks.files = { status = "ok", message = "All required files present" }
    else
        health.checks.files = { status = "error", message = "Missing files: " .. table.concat(missing_files, ", ") }
        health.errors = health.errors + 1
    end

    -- Check 3: Data directory
    local data_dir = nixio.fs.stat("/etc/geomate.d")
    if data_dir and data_dir.type == "dir" then
        health.checks.datadir = { status = "ok", message = "Data directory exists" }
    else
        health.checks.datadir = { status = "error", message = "Data directory missing" }
        health.errors = health.errors + 1
    end

    -- Check 4: Autostart enabled status
    uci:load('geomate')
    local config_enabled = (uci:get('geomate', 'global', 'enabled') == '1')

    local autostart_check = io.popen("/etc/init.d/geomate enabled && echo enabled 2>/dev/null")
    local autostart = false
    if autostart_check then
        local result = autostart_check:read("*l")
        autostart_check:close()
        autostart = (result == "enabled")
    end

    if config_enabled and autostart then
        health.checks.service = { status = "ok", message = "Autostart enabled" }
    elseif not config_enabled and not autostart then
        health.checks.service = { status = "info", message = "Autostart disabled" }
    else
        health.checks.service = { status = "warning", message = "Inconsistent state: config=" .. tostring(config_enabled) .. ", autostart=" .. tostring(autostart) }
    end

    -- Check 5: nftables table (only if service is enabled)
    if config_enabled then
        local nft_check = io.popen("nft list table inet geomate 2>/dev/null")
        if nft_check then
            local result = nft_check:read("*a")
            nft_check:close()
            if result and result ~= "" then
                health.checks.nft = { status = "ok", message = "nftables table active" }
            else
                health.checks.nft = { status = "error", message = "nftables table not active" }
                health.errors = health.errors + 1
            end
        end

        -- Check 6: Process running
        local pid_file = io.open("/var/run/geomate.pid", "r")
        if pid_file then
            local pid = pid_file:read("*l")
            pid_file:close()
            if pid then
                local check = io.popen("kill -0 " .. pid .. " 2>/dev/null && echo running")
                if check then
                    local result = check:read("*l")
                    check:close()
                    if result == "running" then
                        health.checks.process = { status = "ok", message = "Process running (PID: " .. pid .. ")" }
                    else
                        health.checks.process = { status = "error", message = "Process not running (stale PID)" }
                        health.errors = health.errors + 1
                    end
                end
            end
        else
            health.checks.process = { status = "error", message = "Process not running" }
            health.errors = health.errors + 1
        end
    else
        health.checks.nft = { status = "info", message = "Skipped (service disabled)" }
        health.checks.process = { status = "info", message = "Skipped (service disabled)" }
    end

    -- Check 7: nft error log
    local error_log = io.open("/tmp/geomate_nft_errors.log", "r")
    if error_log then
        local content = error_log:read("*a")
        error_log:close()
        if content and content ~= "" then
            health.checks.nft_errors = { status = "warning", message = "nft error log has entries" }
        else
            health.checks.nft_errors = { status = "ok", message = "No nft errors logged" }
        end
    else
        health.checks.nft_errors = { status = "ok", message = "No nft error log" }
    end

    health.healthy = (health.errors == 0)
    return health
end

-- Main function of the RPC script
local methods = {
    getGeomateConnections = {
        -- rpcd takes the type of an argument from the sample value: a boolean
        args = { counters = true },
        call = function(args)
            local connections = get_all_connections(type(args) == "table" and args.counters == true)
            return { connections = connections }
        end
    },
    getAllowedIPs = {
        call = function()
            load_cache()
            local allowed_ips, changed = get_allowed_ips()
            if changed then
                save_cache()
            end
            return { allowed_ips = allowed_ips }
        end
    },
    getKnownServers = {
        args = { sid = 'string' },
        call = function(args)
            return get_known_servers(type(args) == "table" and args.sid or nil)
        end
    },
    getStatus = {
        call = function()
            local status = get_service_status()
            return { status = status }
        end
    },
    getHealthCheck = {
        call = function()
            local health = run_health_check()
            return { health = health }
        end
    },
    getGeolocationStatus = {
        call = function()
            -- Read pre-computed geolocation status from JSON file
            -- This file is updated every 30 minutes by geomate.sh
            local status_file = "/etc/geomate.d/runtime/geolocation_status.json"
            local nft_error_file = "/tmp/geomate_nft_errors.log"
            local f = io.open(status_file, "r")
            local data = nil
            
            if f then
                local content = f:read("*a")
                f:close()
                data = jsonc.parse(content)
                if data then
                    -- Add human-readable timestamps
                    local now = os.time()
                    data.last_update_ago = now - (data.timestamp or now)
                    data.next_cycle_in = (data.next_cycle or now) - now
                    if data.next_cycle_in < 0 then data.next_cycle_in = 0 end
                    
                    -- Frequent geolocation timing
                    if data.geolocation then
                        data.geolocation.last_run_ago = now - (data.geolocation.last_run or 0)
                        data.geolocation.next_run_in = (data.geolocation.next_run or now) - now
                        if data.geolocation.next_run_in < 0 then data.geolocation.next_run_in = 0 end
                    end
                    
                    -- Daily geolocation timing
                    if data.geolocation_daily then
                        data.geolocation_daily.last_run_ago = now - (data.geolocation_daily.last_run or 0)
                        data.geolocation_daily.next_run_in = (data.geolocation_daily.next_run or now) - now
                        if data.geolocation_daily.next_run_in < 0 then data.geolocation_daily.next_run_in = 0 end
                    end
                end
            end
            
            -- Initialize data if not loaded
            if not data then
                data = {
                    timestamp = 0,
                    operational_mode = "unknown",
                    geolocation_mode = "unknown",
                    message = "No geolocation data available yet. Start the service and wait for the first cycle."
                }
            end
            
            -- Check for NFT errors and extract affected filter names
            data.nft_errors = false
            data.nft_error_filters = {}
            local ef = io.open(nft_error_file, "r")
            if ef then
                local error_content = ef:read("*a")
                ef:close()
                if error_content and #error_content > 0 then
                    data.nft_errors = true
                    -- Extract filter names from set references like @geomate_Call_of_Duty_allowed
                    -- (spaces in the name appear as '_', so strip the set suffix instead)
                    local seen = {}
                    for set_name in error_content:gmatch("@geomate_([%w_.%-]*[%w_])") do
                        local filter_name = set_name:match("^(.+)_ui_dynamic$") or set_name:match("^(.+)_%a+$")
                        if filter_name and not seen[filter_name] then
                            seen[filter_name] = true
                            table.insert(data.nft_error_filters, filter_name)
                        end
                    end
                end
            end
            
            -- The Geo Filters page offers several Source IP entries only with src_ip_multi
            data.capabilities = backend_capabilities()
            
            return { status = data }
        end
    }
}

-- Handle RPC calls
if arg[1] == "list" then
    local rv = {}
    for k, v in pairs(methods) do
        rv[k] = v.args or {}
    end
    print((jsonc.stringify(rv):gsub(":%[%]", ":{}")))
elseif arg[1] == "call" then
    local args = jsonc.parse(io.stdin:read("*a"))
    local method = methods[arg[2]]
    if method then
        local result = method.call(args)
        print(jsonc.stringify(result))
        os.exit(result.code or 0)
    else
        print(jsonc.stringify({ error = "Method not found" }))
        os.exit(1)
    end
end
